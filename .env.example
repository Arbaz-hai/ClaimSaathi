# ============================================================
# ClaimSaathi — environment configuration
# Copy to .env and adjust. The app runs fine with defaults
# (demo mode, no external API key).
# ============================================================

# Execution mode for the Sarvam AI provider:
#   demo   -> no external calls; rule-based agents, prepared
#             translations, sample transcripts. Default.
#   sarvam -> real Sarvam AI calls for the capabilities that
#             are enabled below. Workflow rules stay local.
AI_MODE=demo

# Sarvam AI subscription key (https://indus.sarvam.ai/key-management)
# NEVER expose this in the browser; it is only read server-side.
SARVAM_API_KEY=

# Optional: Sarvam API base URL override (default https://api.sarvam.ai)
# SARVAM_BASE_URL=https://api.sarvam.ai

# Per-capability toggles for connected mode (true/false).
# All default to true when a SARVAM_API_KEY is present.
# SARVAM_ENABLE_STT=true
# SARVAM_ENABLE_TRANSLATE=true
# SARVAM_ENABLE_TTS=true
# SARVAM_ENABLE_GENERATION=true

# Prisma / SQLite database URL (relative to prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# Optional: override where local uploads are stored (default: <project>/data)
# CLAIMSATHI_DATA_DIR=C:\path\to\private\data
